{
  "name": "@hoppo/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Hoppo student app — ordering and riding",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{app,src}/**/*.{ts,tsx}\" --max-warnings 0"
  },
  "dependencies": {
    "@hoppo/api-client": "workspace:*",
    "@hoppo/shared": "workspace:*",
    "expo": "~52.0.42",
    "expo-constants": "~17.0.8",
    "expo-linking": "~7.0.5",
    "expo-location": "~18.0.10",
    "expo-router": "~4.0.20",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.7.3"
  }
}
