# Expo inlines anything prefixed EXPO_PUBLIC_ into the bundle, so this must be
# a public value — never a secret.
#
# On a physical device, localhost is the phone, not your laptop. Use your
# machine's LAN address: EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
