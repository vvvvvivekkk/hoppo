# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# Never commit .env — it is in .gitignore for a reason.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_DASHBOARD_URL=http://localhost:3001
WEB_ADMIN_URL=http://localhost:3002

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://hoppo:hoppo_dev_password@localhost:5432/hoppo?schema=public

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# FR-AUTH-06: lock an account after this many consecutive failed attempts
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Object storage (Cloudflare R2 in production, MinIO locally)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=hoppo
S3_SECRET_ACCESS_KEY=hoppo_dev_password
S3_BUCKET_PUBLIC=hoppo-public
S3_BUCKET_PRIVATE=hoppo-private
S3_FORCE_PATH_STYLE=true

# Identity documents are encrypted at rest on top of bucket encryption.
# NFR-S-03 / C-3. Generate with: openssl rand -hex 32
DOCUMENT_ENCRYPTION_KEY=replace_me_with_64_hex_characters

# ---------------------------------------------------------------------------
# External services
# ---------------------------------------------------------------------------
# SMS / OTP — MSG91 in production. Leave the key blank in development and
# OTPs are written to the server log instead of being sent.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=HOPPO
MSG91_OTP_TEMPLATE_ID=

# Push notifications — Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Geocoding — Google Maps Platform
GOOGLE_MAPS_API_KEY=

# Payments — Razorpay (Route for split settlement, X for rider payouts)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
POSTHOG_API_KEY=
